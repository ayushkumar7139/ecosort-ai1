# AWS Configuration (optional - for DynamoDB and S3)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# DynamoDB table name
DYNAMODB_TABLE=ecosort-scans

# S3 bucket for image storage (optional)
S3_BUCKET=ecosort-images

# Set to 'true' for demo mode when no AI API is configured
DEMO_MODE=false

# AI provider: 'huggingface', 'bedrock', or 'demo'
AI_PROVIDER=huggingface

# Hugging Face API token (free tier available)
HUGGINGFACE_TOKEN=your_hf_token_here

# Hugging Face model (image classification)
HUGGINGFACE_MODEL=google/vit-base-patch16-224

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Max upload size in MB
MAX_UPLOAD_MB=10
